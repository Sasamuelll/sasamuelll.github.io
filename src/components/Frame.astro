---
// Рамка с двойной границей и заголовком в разрыве верхней линии —
// как окна в старых текстовых интерфейсах
interface Props {
  title?: string;
  class?: string;
}

const { title, class: cls } = Astro.props;
---

<section class:list={['frame', cls]}>
  {title && <h2 class="frame-title">{title}</h2>}
  <div class="frame-body">
    <slot />
  </div>
</section>
