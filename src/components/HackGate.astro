---
// Гейт приватного режима: полноэкранный оверлей с миниигрой.
// Рендерится в Layout только когда PRIVATE_MODE === true.
import { SITE_VENDOR, SITE_SYSTEM } from '../consts';
---

<div class="hack-gate" id="hack-gate">
  <div class="hack-gate__inner">
    <div class="hack" data-hack-gate>
      <div class="hack__head">
        <p>{SITE_VENDOR} (TM) {SITE_SYSTEM}</p>
        <p>ENTER PASSWORD NOW</p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // если уже разблокировано в этой сессии — прячем гейт до отрисовки (без мигания)
  (function () {
    if (sessionStorage.getItem('unlocked')) {
      var g = document.getElementById('hack-gate');
      if (g) g.style.display = 'none';
    }
  })();
</script>

<script>
  import { buildHackGame } from '../scripts/hackGame';

  const gate = document.getElementById('hack-gate');
  const root = gate?.querySelector<HTMLElement>('[data-hack-gate]');

  if (gate && root) {
    if (sessionStorage.getItem('unlocked')) {
      gate.remove();
    } else {
      // запрещаем прокрутку фона, пока гейт открыт
      document.documentElement.style.overflow = 'hidden';
      buildHackGame(root, {
        grantText: 'ACCESS GRANTED, WELCOME…',
        allowRetry: true, // провалил все попытки — можно пересобрать поле
        onGranted: () => {
          sessionStorage.setItem('unlocked', '1');
          gate.classList.add('hack-gate--done');
          document.documentElement.style.overflow = '';
          setTimeout(() => gate.remove(), 500);
        },
      });
    }
  }
</script>
